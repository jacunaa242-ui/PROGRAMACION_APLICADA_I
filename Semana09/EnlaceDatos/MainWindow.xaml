<Window x:Class="EnlaceDatos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EnlaceDatos"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="0,10,0,151">
            <TextBox TextWrapping="Wrap" Text="{Binding nombre}" Width="799" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" Height="32"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding nombre}" Height="35"/>
            <TextBox TextWrapping="Wrap" Text="{Binding nombre, Mode=OneWay}" Width="800" HorizontalAlignment="Left" Height="30"/>
            <TextBox TextWrapping="Wrap" Text="{Binding Precio, Mode=OneWayToSource}" Width="800" HorizontalAlignment="Left" Height="30"/>
            <Button Content="Mostrar" Click="Button_Click" Height="30"/>
        </StackPanel>

    </Grid>
</Window>
