<Window x:Class="Norhtwind.fmrBuscarCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Norhtwind"
        mc:Ignorable="d"
        Title="fmrBuscarCliente" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="59*"/>
            <RowDefinition Height="375*"/>
        </Grid.RowDefinitions>
        <TextBox HorizontalAlignment="Left" Margin="23,0,0,0" TextWrapping="Wrap" Text="Seleccionar país: " VerticalAlignment="Center" Width="120" FontWeight="Bold" FontSize="14"/>
        <ComboBox x:Name="cbxpais" HorizontalAlignment="Left" Margin="199,0,0,0" VerticalAlignment="Center" Width="136" Height="20" SelectionChanged="cbxpais_SelectionChanged"/>
        <ListView x:Name="lvCliente" Grid.Row="1" >
            <ListView.View>
                <GridView>
                    <GridViewColumn DisplayMemberBinding="{Binding CustomerID}" Header="ID" Width="100"/>
                    <GridViewColumn DisplayMemberBinding="{Binding CompanyName}" Header="Nombre Compania" Width="200"/>
                    <GridViewColumn DisplayMemberBinding="{Binding ContactName}" Width="200" Header="Nombre Cliente"/>
                    <GridViewColumn DisplayMemberBinding="{Binding Country}" Width="100" Header="Ciudad"/>
                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</Window>
