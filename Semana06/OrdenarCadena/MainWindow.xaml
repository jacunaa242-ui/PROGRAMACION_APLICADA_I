<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="OrdenarCadena.MainWindow"
        Title="OrdenarCadena"
        Height="550"
        Width="950"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="txtCadena" Grid.Row="0" Height="80" Margin="10" FontSize="18" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Liliana Angelina Leticia Amanda Patricia Roxana Luana Kiara Kimberly Synthia Cintia Cecilia Ana Lina Thalia Teresa Pierina"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="90,5">

            <Button x:Name="btnListar" Width="150" Height="40" FontWeight="Bold" FontSize="16" Content="&lt;&lt;Listar&gt;&gt;" Click="btnListar_Click"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <ListBox x:Name="lstNombres" Height="260" FontSize="16" d:ItemsSource="{d:SampleData ItemCount=5}"/>

                <TextBox x:Name="txtCantidad1" Width="70" Margin="0,10,0,0" HorizontalAlignment="Left" IsReadOnly="True"/>

            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Label Content="Letra" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBox x:Name="txtLetra" Width="120" Height="35" FontSize="18" HorizontalContentAlignment="Center" Margin="0,10"/>

                <Button x:Name="btnPasar" Width="150" Height="40" FontWeight="Bold" FontSize="16" Content="&lt;&lt;Pasar&gt;&gt;" Click="btnPasar_Click"/>

            </StackPanel>

            <StackPanel Grid.Column="2">
                <ListBox x:Name="lstResultado" Height="260" FontSize="16" d:ItemsSource="{d:SampleData ItemCount=5}"/>

                <TextBox x:Name="txtCantidad2" Width="70" Margin="0,20,0,0" HorizontalAlignment="Left" IsReadOnly="True" Height="25"/>
            </StackPanel>

        </Grid>

    </Grid>

</Window>
