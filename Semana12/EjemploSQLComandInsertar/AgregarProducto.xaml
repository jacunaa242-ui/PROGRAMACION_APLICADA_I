<Window x:Class="EjemploSQLComandInsertar.AgregarProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EjemploSQLComandInsertar"
        mc:Ignorable="d"
        Title="Agregar Productos"
        Height="650"
        Width="900" Loaded="Window_Loaded">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ============================= -->
        <!-- FORMULARIO -->
        <!-- ============================= -->

        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- NOMBRE DEL PRODUCTO -->

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Nombre Producto:"
                           Width="120"/>

                <TextBox x:Name="txtNombre"
                         Width="200"/>

            </StackPanel>


            <!-- PRECIO -->

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Precio:"
                           Width="120"/>

                <TextBox x:Name="txtPrecio"
                         Width="200"/>

            </StackPanel>


            <!-- CATEGORÍA -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">

                <TextBlock Text="Categoría:"
                           Width="120"/>

                <TextBox x:Name="txtCategoria"
                         Width="200"
                         Margin="0,0,10,0"/>

                <Button x:Name="btnAgregarCategoria"
                        Content="Agregar Categoría"
                        Width="130"
                        Click="btnAgregarCategoria_Click"/>

            </StackPanel>


            <!-- BOTONES -->

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,20">

                <Button x:Name="btnNuevo"
                        Content="Nuevo"
                        Width="100"
                        Margin="0,0,10,0"
                        Click="btnNuevo_Click"/>

                <Button x:Name="btnRegistrar"
                        Content="Agregar Producto"
                        Width="120"
                        Click="btnRegistrar_Click"/>

            </StackPanel>

        </Grid>


        <!-- ============================= -->
        <!-- DATAGRID -->
        <!-- ============================= -->

        <DataGrid x:Name="dgProductos"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Margin="0,10,0,0">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding ProductID}"
                                    Width="60"/>

                <DataGridTextColumn Header="Producto"
                                    Binding="{Binding ProductName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding UnitPrice, StringFormat={}{0:C2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="ID Categoría"
                                    Binding="{Binding CategoryID}"
                                    Width="100"/>

                <DataGridTextColumn Header="Categoría"
                                    Binding="{Binding CategoryName}"
                                    Width="180"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>

