<Window x:Class="Conecta4.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conecta 4" Height="600" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Turno actual: " FontSize="18" FontWeight="Bold" Foreground="#333"/>
                    <TextBlock x:Name="lblTurno" Text="Jugador 1" FontSize="18" FontWeight="Bold" Foreground="#D32F2F" Margin="5,0,0,0"/>
                </StackPanel>

                <Button x:Name="btnReiniciar" Grid.Column="1" Content="Reiniciar Juego" 
                        Padding="12,6" FontSize="14" FontWeight="SemiBold"
                        Background="#1976D2" Foreground="White" BorderThickness="0"
                        Click="btnReiniciar_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#0D47A1" CornerRadius="12" Padding="10">
            <UniformGrid x:Name="gridTablero" Rows="6" Columns="7"/>
        </Border>

  
        <TextBlock x:Name="lblEstado" Grid.Row="2" Text="¡Haz clic en cualquier columna para soltar una ficha!" 
                   HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="14" Foreground="#555"/>
    </Grid>
</Window>
