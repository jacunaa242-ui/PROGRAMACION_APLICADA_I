<Window x:Class="Conecta4.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conecta 4" Height="680" Width="720"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Panel de Configuración -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <WrapPanel HorizontalAlignment="Center">
                <TextBlock Text="Modo:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbModoJuego" Width="150" Margin="0,0,15,0" SelectionChanged="Opciones_SelectionChanged">
                    <ComboBoxItem Content="vs Computadora" IsSelected="True"/>
                    <ComboBoxItem Content="2 Jugadores (PvP)"/>
                </ComboBox>

                <TextBlock x:Name="lblDificultad" Text="Dificultad:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbDificultad" Width="110" Margin="0,0,15,0" SelectionChanged="Opciones_SelectionChanged">
                    <ComboBoxItem Content="Fácil"/>
                    <ComboBoxItem Content="Medio" IsSelected="True"/>
                    <ComboBoxItem Content="Difícil"/>
                </ComboBox>

                <Button x:Name="btnReiniciar" Content="Nueva Partida" Padding="10,4" 
                Background="#1976D2" Foreground="White" FontWeight="Bold" BorderThickness="0"
                Click="btnReiniciar_Click"/>
            </WrapPanel>
        </Border>

        <!-- Panel de Estado -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Turno de: " FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="lblTurno" Text="Jugador 1" FontSize="16" FontWeight="Bold" Foreground="#D32F2F"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#0D47A1" CornerRadius="12" Padding="10">
            <UniformGrid x:Name="gridTablero" Rows="6" Columns="7"/>
        </Border>


        <TextBlock x:Name="lblEstado" Grid.Row="3" Text="Selecciona una columna para comenzar." 
                   HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="13" Foreground="#555"/>
    </Grid>
</Window>
